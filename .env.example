# Self Hypnosis Goddess — Frontend Environment Variables
#
# The app talks to Cloudflare Workers, which hold every key server-side.
# Nothing secret belongs in this file: anything prefixed VITE_ ships in the
# public bundle.

# Auth worker (signup / login / logout / me)
VITE_AUTH_WORKER_URL=https://shg-auth-worker.airpriestess.workers.dev
