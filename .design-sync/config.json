{
  "projectId": "acb0f474-0d15-45fc-b955-07b9c1d49a87",
  "shape": "package",
  "pkg": "shg-frontend",
  "globalName": "SHG",
  "srcDir": "src",
  "buildCmd": "node .design-sync/prep.mjs",
  "cssEntry": ".design-sync/ds-styles.css",
  "extraEntries": [
    "./.design-sync/preview-support.jsx",
    "./.design-sync/ds-entry.jsx"
  ],
  "provider": {
    "component": "SHGPreviewProvider"
  },
  "componentSrcMap": {
    "App": null,
    "AuthProvider": null,
    "SHGPreviewProvider": null
  },
  "libOverrides": {
    "source-kit.mjs": "exclude app-bootstrap (createRoot/render) files from synth entry"
  },
  "overrides": {
    "Modal": {
      "cardMode": "single",
      "viewport": "560x720",
      "primaryStory": "LogASign"
    },
    "CreateThreadModal": {
      "cardMode": "single",
      "viewport": "560x940"
    },
    "PhotoProofModal": {
      "cardMode": "single",
      "viewport": "560x900"
    },
    "VoiceProofModal": {
      "cardMode": "single",
      "viewport": "560x760"
    },
    "KnowledgeGuide": {
      "cardMode": "single",
      "viewport": "600x760"
    },
    "Science": {
      "cardMode": "column"
    }
  },
  "extraFonts": [
    ".design-sync/fonts.css"
  ],
  "readmeHeader": ".design-sync/conventions.md"
}